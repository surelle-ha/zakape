{
  "name": "@zakape/studio",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3300",
    "build": "nuxt generate",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native-close": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/native/window-close.ps1",
    "android:debug": "tauri android build --debug --apk --target aarch64 --ci",
    "android:fdroid": "tauri android build --apk --target aarch64 --target armv7 --ci",
    "android:bundle": "tauri android build --aab --target aarch64 --target armv7 --ci",
    "tauri": "tauri"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/handjet": "^5.3.0",
    "@lucide/vue": "^1.48.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "animejs": "^4.5.0",
    "gifenc": "^1.0.3",
    "motion": "^13.4.3",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.11.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.1.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
