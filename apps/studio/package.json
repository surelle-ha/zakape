{
  "name": "@zakape/studio",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3300",
    "build": "nuxt generate",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native-close": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/native/window-close.ps1",
    "android:debug": "tauri android build --debug --apk --target aarch64 --ci",
    "android:fdroid": "tauri android build --apk --target aarch64 --target armv7 --ci",
    "android:bundle": "tauri android build --aab --target aarch64 --target armv7 --ci",
    "tauri": "tauri"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/handjet": "^5.3.1",
    "@lucide/vue": "^1.57.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "animejs": "^4.5.0",
    "gifenc": "^1.0.3",
    "motion": "^14.3.0",
    "nuxt": "^4.6.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.12.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
