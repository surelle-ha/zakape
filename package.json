{
  "name": "zakape",
  "version": "0.12.1",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @zakape/studio dev",
    "dev:site": "pnpm --filter @zakape/site dev",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @zakape/studio tauri build",
    "build:android:debug": "pnpm --filter @zakape/studio tauri android build --debug --apk --target aarch64 --ci",
    "build:android:fdroid": "pnpm --filter @zakape/studio tauri android build --apk --target aarch64 --target armv7 --ci",
    "build:android:bundle": "pnpm --filter @zakape/studio tauri android build --aab --target aarch64 --target armv7 --ci",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:fdroid",
    "check:fdroid": "node scripts/verify-fdroid.mjs",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @zakape/studio test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "prettier": "^3.6.2"
  }
}
