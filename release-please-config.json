{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "zakape",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        {
          "type": "json",
          "path": "apps/site/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/studio/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "apps/studio/src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "apps/studio/src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='zakape')].version"
        }
      ]
    }
  }
}
